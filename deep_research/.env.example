# Deep Research Agent - Environment Variables
# Copy this file to .env and fill in your values

# ======================
# OpenAI Configuration
# ======================
OPENAI_API_KEY=sk-your-openai-api-key

# ======================
# Supabase Configuration
# ======================
# Get these from your Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Or use anon key (less privileges)
SUPABASE_ANON_KEY=your-anon-key

# For frontend (Next.js requires NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ======================
# LangSmith Configuration (Optional)
# ======================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=deep-research-agent

# ======================
# Email Configuration (Optional)
# ======================
GMAIL_SENDER_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# ======================
# API v2.0 Configuration
# ======================
# JWT secret for validating Supabase tokens (optional if using Supabase hosted)
# Get from Supabase Dashboard -> Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# Environment (development | staging | production)
ENVIRONMENT=development

# Rate limiting (optional - defaults shown)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE_RESEARCH_PER_DAY=2
RATE_LIMIT_PRO_RESEARCH_PER_DAY=20

# Feature flags (optional)
FEATURE_API_KEYS=true
FEATURE_EMAIL_DELIVERY=true
FEATURE_PDF_EXPORT=false
